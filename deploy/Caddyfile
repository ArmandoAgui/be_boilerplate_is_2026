{
    email {$ACME_EMAIL}
    admin off
    servers {
        protocols h1 h2
    }
}

{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 20MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    log {
        output stdout
        format json
    }
    reverse_proxy web:3000
}
