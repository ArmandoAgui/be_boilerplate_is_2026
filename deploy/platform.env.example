# Generado por bootstrap-ubuntu.sh en /etc/sonnet5/platform.env (0600).
# Los valores son datos; no se evalúa este archivo como un script de shell.
STACK_NAME=sonnet5
STACK_DIR=/opt/sonnet5
STATE_DIR=/var/lib/sonnet5
BACKUP_DIR=/var/backups/sonnet5
SECRETS_DIR=/etc/sonnet5/secrets
DOMAIN=condominio.example.com
ACME_EMAIL=operador@example.com
ADMIN_EMAIL=administrador@example.com
CUOTA_MENSUAL_USD=50.00
BACKUP_RETENTION_DAYS=7
# Opcional: bucket privado preexistente, con IAM instance role.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=sonnet5
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Copiar valores reales verificados de deploy/base-images.env.
NODE_IMAGE=node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5
