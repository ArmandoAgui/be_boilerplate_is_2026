// Add to User model: paquetesRecibidos Paquete[]; asambleasCreadas Asamblea[]
// Add to Unidad model: paquetes Paquete[]; participacionesVoto ParticipacionVoto[]
// Add the following definitions to schema.prisma:
enum EstadoPaquete { PENDIENTE ENTREGADO }
enum EstadoAsamblea { BORRADOR PUBLICADA }
model Paquete {
 id String @id @default(uuid()) @db.Uuid
 codigo String @unique @db.VarChar(32)
 empresa String @db.VarChar(100)
 descripcion String? @db.VarChar(500)
 recibidoAt DateTime @default(now()) @db.Timestamptz(3)
 estado EstadoPaquete @default(PENDIENTE)
 entregadoAt DateTime? @db.Timestamptz(3)
 retiraNombre String? @db.VarChar(100)
 unidadId String @db.Uuid
 recibidoPorId String? @db.Uuid
 unidad Unidad @relation(fields:[unidadId],references:[id],onDelete:Restrict)
 recibidoPor User? @relation(fields:[recibidoPorId],references:[id],onDelete:Restrict)
 @@index([unidadId,estado,recibidoAt])
 @@map("paquetes")
}
model Asamblea {
 id String @id @default(uuid()) @db.Uuid
 titulo String @db.VarChar(100)
 fechaAt DateTime @db.Timestamptz(3)
 descripcion String? @db.VarChar(500)
 estado EstadoAsamblea @default(BORRADOR)
 creadorId String @db.Uuid
 publicadaAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 creador User @relation(fields:[creadorId],references:[id],onDelete:Restrict)
 temas TemaVotacion[]
 @@index([estado,fechaAt])
 @@map("asambleas")
}
model TemaVotacion {
 id String @id @default(uuid()) @db.Uuid
 asambleaId String @db.Uuid
 pregunta String @db.VarChar(150)
 aperturaAt DateTime @db.Timestamptz(3)
 cierreAt DateTime @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 asamblea Asamblea @relation(fields:[asambleaId],references:[id],onDelete:Restrict)
 opciones OpcionVoto[]
 participaciones ParticipacionVoto[]
 votos Voto[]
 @@index([asambleaId])
 @@map("temas_votacion")
}
model OpcionVoto {
 id String @id @default(uuid()) @db.Uuid
 temaId String @db.Uuid
 texto String @db.VarChar(100)
 tema TemaVotacion @relation(fields:[temaId],references:[id],onDelete:Restrict)
 votos Voto[]
 @@unique([temaId,texto])
 @@map("opciones_voto")
}
model ParticipacionVoto {
 id String @id @default(uuid()) @db.Uuid
 temaId String @db.Uuid
 unidadId String @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 tema TemaVotacion @relation(fields:[temaId],references:[id],onDelete:Restrict)
 unidad Unidad @relation(fields:[unidadId],references:[id],onDelete:Restrict)
 @@unique([unidadId,temaId])
 @@map("participaciones_voto")
}
model Voto {
 id String @id @default(uuid()) @db.Uuid
 temaId String @db.Uuid
 opcionId String @db.Uuid
 tema TemaVotacion @relation(fields:[temaId],references:[id],onDelete:Restrict)
 opcion OpcionVoto @relation(fields:[opcionId],references:[id],onDelete:Restrict)
 @@index([temaId,opcionId])
 @@map("votos")
}
