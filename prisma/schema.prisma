// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rol            Rol                  @default(RESIDENTE)
  nombre         String               @default("Residente")
  telefono       String?
  unidades            UsuarioUnidad[]
  reservas             Reserva[]
  autorizaciones       AutorizacionVisita[]
  // H14: registra quién controló ingreso y salida.
  ingresosRegistrados  MovimientoVisita[] @relation("IngresosRegistrados")
  salidasRegistradas   MovimientoVisita[] @relation("SalidasRegistradas")
  refreshTokens        RefreshToken[]
  // H9: conserva autor, responsable e historial de incidencias.
  incidenciasCreadas   Incidencia[]        @relation("ResidenteIncidencias")
  incidenciasAsignadas Incidencia[]        @relation("ResponsableIncidencias")
  historialIncidencias HistorialIncidencia[] @relation("ActorHistorialIncidencia")
  // H16: quién recibió el paquete y, más adelante, quién lo entregó.
  paquetesRegistrados  Paquete[]           @relation("PaquetesRegistrados")
  paquetesEntregados   Paquete[]           @relation("PaquetesEntregados")

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// Base compartida mínima del PDF, un solo condominio. Sin administración pública de roles.
enum Rol {
  RESIDENTE
  ADMINISTRADOR
  SEGURIDAD
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
}

model Torre {
  id        String    @id @default(uuid()) @db.Uuid
  nombre    String    @unique @db.VarChar(30)
  secciones Seccion[]
  unidades  Unidad[]
}

model Seccion {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String   @db.VarChar(30)
  torreId  String   @db.Uuid
  torre    Torre    @relation(fields: [torreId], references: [id], onDelete: Restrict)
  unidades Unidad[]

  @@unique([torreId, nombre])
  @@unique([id, torreId])
}

model Unidad {
  id             String               @id @default(uuid()) @db.Uuid
  codigo         String               @unique
  torreId        String               @db.Uuid
  seccionId      String               @db.Uuid
  cuotaMensual   Decimal              @db.Decimal(10, 2)
  activa         Boolean              @default(true)
  torre          Torre                @relation(fields: [torreId], references: [id], onDelete: Restrict)
  seccion        Seccion              @relation(fields: [seccionId, torreId], references: [id, torreId], onDelete: Restrict)
  usuarios       UsuarioUnidad[]
  reservas       Reserva[]
  autorizaciones AutorizacionVisita[]
  movimientos    MovimientoVisita[]
  paquetes       Paquete[]
  cuotas         Cuota[]
  incidencias    Incidencia[]
}

model UsuarioUnidad {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  unidadId String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  @@unique([userId, unidadId])
  @@index([unidadId])
}

model AreaComun {
  id        String        @id @default(uuid()) @db.Uuid
  nombre    String        @unique @db.VarChar(60)
  capacidad Int
  activa    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  horarios  HorarioArea[]
  reservas  Reserva[]
  incidencias Incidencia[]
}

model HorarioArea {
  id         String    @id @default(uuid()) @db.Uuid
  areaId     String    @db.Uuid
  diaSemana  Int
  horaInicio String    @db.VarChar(5)
  horaFin    String    @db.VarChar(5)
  area       AreaComun @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId, diaSemana])
}

model Reserva {
  id          String        @id @default(uuid()) @db.Uuid
  codigo      String        @unique @default(dbgenerated("reserva_codigo()"))
  areaId      String        @db.Uuid
  unidadId    String?       @db.Uuid
  userId      String        @db.Uuid
  inicio      DateTime      @db.Timestamptz(3)
  fin         DateTime      @db.Timestamptz(3)
  asistentes  Int
  estado      EstadoReserva @default(CONFIRMADA)
  canceladaAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  area        AreaComun     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  unidad      Unidad?       @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([areaId, inicio, fin])
  @@index([unidadId, estado, inicio])
  @@index([userId, estado, inicio])
}

// Módulo 4 — Control de acceso de visitas (H13).
enum EstadoAutorizacion {
  VIGENTE
  USADA
  CANCELADA
}

model AutorizacionVisita {
  id                 String             @id @default(uuid()) @db.Uuid
  residenteId        String             @db.Uuid
  unidadId           String             @db.Uuid
  visitanteNombre    String             @db.VarChar(100)
  visitanteDocumento String             @db.VarChar(20)
  inicio             DateTime           @db.Timestamptz(3)
  fin                DateTime           @db.Timestamptz(3)
  // Vencida no se almacena: es VIGENTE con fin anterior a ahora. Guardarla
  // obligaría a una tarea programada que mantuviera la columna al día.
  estado             EstadoAutorizacion @default(VIGENTE)
  canceladaAt        DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  residente          User               @relation(fields: [residenteId], references: [id], onDelete: Restrict)
  unidad             Unidad             @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  movimiento         MovimientoVisita?

  @@index([residenteId, estado, inicio])
  // Seguridad busca en la puerta entre las vigentes dentro de su ventana (H14).
  @@index([estado, fin])
  @@index([visitanteDocumento])
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
}

model Cuota {
  id               String      @id @default(uuid()) @db.Uuid
  unidadId         String      @db.Uuid
  concepto         String      @default("Cuota de mantenimiento") @db.VarChar(60)
  periodo          String      @db.VarChar(7)
  monto            Decimal     @db.Decimal(10, 2)
  fechaVencimiento DateTime    @db.Date
  estado           EstadoCuota @default(PENDIENTE)
  fechaPago        DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  unidad           Unidad      @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  @@unique([unidadId, periodo, concepto])
  @@index([unidadId, estado])
}

enum LugarTipo {
  UNIDAD
  AREA_COMUN
}

enum Categoria {
  FUGA
  ELECTRICIDAD
  ASCENSOR
  LIMPIEZA
  SEGURIDAD
  OTRO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EstadoIncidencia {
  ABIERTA
  ASIGNADA
  EN_PROCESO
  RESUELTA
}

enum CampoHistorial {
  ESTADO
  PRIORIDAD
  RESPONSABLE
}

model Incidencia {
  id            String           @id @default(uuid()) @db.Uuid
  codigo        String           @unique(map: "incidencias_codigo_key") @default(dbgenerated("incidencia_codigo()")) @db.VarChar(32)
  residenteId   String           @map("residente_id") @db.Uuid
  lugarTipo     LugarTipo        @map("lugar_tipo")
  unidadId      String?          @map("unidad_id") @db.Uuid
  areaId        String?          @map("area_id") @db.Uuid
  categoria     Categoria
  descripcion   String           @db.VarChar(500)
  prioridad     Prioridad?
  estado        EstadoIncidencia @default(ABIERTA)
  responsableId String?          @map("responsable_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  residente    User                  @relation("ResidenteIncidencias", fields: [residenteId], references: [id], onDelete: Restrict)
  responsable  User?                 @relation("ResponsableIncidencias", fields: [responsableId], references: [id], onDelete: Restrict)
  unidad       Unidad?               @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  area         AreaComun?            @relation(fields: [areaId], references: [id], onDelete: Restrict)
  evidencias   EvidenciaIncidencia[]
  historial    HistorialIncidencia[]

  @@index([residenteId, createdAt(sort: Desc)], map: "incidencias_residente_created_at_idx")
  @@index([responsableId], map: "incidencias_responsable_id_idx")
  @@index([unidadId], map: "incidencias_unidad_id_idx")
  @@index([areaId], map: "incidencias_area_id_idx")
  @@map("incidencias")
}

model EvidenciaIncidencia {
  id            String     @id @default(uuid()) @db.Uuid
  incidenciaId  String     @map("incidencia_id") @db.Uuid
  ruta          String     @unique(map: "evidencias_incidencia_ruta_key") @db.VarChar(255)
  mime          String     @db.VarChar(20)
  tamanoBytes   Int        @map("tamano_bytes")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  incidencia Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Restrict)

  @@index([incidenciaId], map: "evidencias_incidencia_incidencia_id_idx")
  @@map("evidencias_incidencia")
}

model HistorialIncidencia {
  id             String         @id @default(uuid()) @db.Uuid
  incidenciaId   String         @map("incidencia_id") @db.Uuid
  campo          CampoHistorial
  valorAnterior  String?        @map("valor_anterior") @db.VarChar(500)
  valorNuevo     String         @map("valor_nuevo") @db.VarChar(500)
  actorId        String         @map("actor_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  incidencia Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Restrict)
  actor      User       @relation("ActorHistorialIncidencia", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([incidenciaId, createdAt(sort: Desc)], map: "historial_incidencia_incidencia_created_at_idx")
  @@index([actorId], map: "historial_incidencia_actor_id_idx")
  @@map("historial_incidencia")
}

// H14 — Bitácora de accesos. Registra a todo el que entra, con autorización o sin ella.
enum Condicion {
  PREAUTORIZADA
  SIN_AUTORIZACION
}

model MovimientoVisita {
  id                 String              @id @default(uuid()) @db.Uuid
  // Única y opcional: la autorización es de uso único, así que no puede
  // respaldar dos ingresos, y una visita sin autorización no tiene ninguna.
  autorizacionId     String?             @unique @db.Uuid
  unidadId           String              @db.Uuid
  // Se copian en lugar de leerse de la autorización: la bitácora debe decir a
  // quién se dejó entrar, aunque después se edite o se borre el origen.
  visitanteNombre    String              @db.VarChar(100)
  visitanteDocumento String              @db.VarChar(20)
  condicion          Condicion
  ingresoAt          DateTime            @default(now()) @db.Timestamptz(3)
  // Nulo significa que el visitante sigue dentro. Es la base de H15.
  salidaAt           DateTime?           @db.Timestamptz(3)
  ingresoPorId       String              @db.Uuid
  salidaPorId        String?             @db.Uuid
  autorizacion       AutorizacionVisita? @relation(fields: [autorizacionId], references: [id], onDelete: Restrict)
  unidad             Unidad              @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  ingresoPor         User                @relation("IngresosRegistrados", fields: [ingresoPorId], references: [id], onDelete: Restrict)
  salidaPor          User?               @relation("SalidasRegistradas", fields: [salidaPorId], references: [id], onDelete: Restrict)

  @@index([salidaAt])
}

// Módulo 5 — Paquetería (H16).
enum EstadoPaquete {
  PENDIENTE
  ENTREGADO
}

model Paquete {
  id String @id @default(uuid()) @db.Uuid
  // Lo arma el repositorio con la secuencia paquete_codigo_seq, que se crea a
  // mano en la migración. Contar filas o leer el máximo no sirve: dos guardias
  // registrando a la vez obtendrían el mismo número.
  codigo          String        @unique @db.VarChar(20)
  unidadId        String        @db.Uuid
  empresa         String        @db.VarChar(60)
  descripcion     String?       @db.VarChar(120)
  recibidoAt      DateTime      @default(now()) @db.Timestamptz(3)
  estado          EstadoPaquete @default(PENDIENTE)
  // Los cuatro campos de entrega los llena H17, pero se crean desde acá: la
  // tarjeta define el modelo completo en H16 y el historial de H19 ya los lee.
  // Dejarlos para después obligaría a otro a agregarlos en su propia rama.
  entregadoAt     DateTime?     @db.Timestamptz(3)
  retiraNombre    String?       @db.VarChar(100)
  retiraDocumento String?       @db.VarChar(20)
  registradoPorId String        @db.Uuid
  entregadoPorId  String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  unidad        Unidad @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  registradoPor User   @relation("PaquetesRegistrados", fields: [registradoPorId], references: [id], onDelete: Restrict)
  entregadoPor  User?  @relation("PaquetesEntregados", fields: [entregadoPorId], references: [id], onDelete: Restrict)

  // Seguridad lista los pendientes más recientes (H17) y el residente su
  // historial por unidad (H19).
  @@index([estado, recibidoAt])
  @@index([unidadId, recibidoAt])
}
