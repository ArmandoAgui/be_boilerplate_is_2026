// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rol           Rol             @default(RESIDENTE)
  nombre        String          @default("Residente")
  telefono      String?
  unidades      UsuarioUnidad[]
  reservas      Reserva[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// Base compartida mínima del PDF, un solo condominio. Sin administración pública de roles.
enum Rol {
  RESIDENTE
  ADMINISTRADOR
  SEGURIDAD
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
}

model Torre {
  id        String    @id @default(uuid()) @db.Uuid
  nombre    String    @unique @db.VarChar(30)
  secciones Seccion[]
  unidades  Unidad[]
}

model Seccion {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String   @db.VarChar(30)
  torreId  String   @db.Uuid
  torre    Torre    @relation(fields: [torreId], references: [id], onDelete: Restrict)
  unidades Unidad[]

  @@unique([torreId, nombre])
  @@unique([id, torreId])
}

model Unidad {
  id           String          @id @default(uuid()) @db.Uuid
  codigo       String          @unique
  torreId      String          @db.Uuid
  seccionId    String          @db.Uuid
  cuotaMensual Decimal         @db.Decimal(10, 2)
  activa       Boolean         @default(true)
  torre        Torre           @relation(fields: [torreId], references: [id], onDelete: Restrict)
  seccion      Seccion         @relation(fields: [seccionId, torreId], references: [id, torreId], onDelete: Restrict)
  usuarios     UsuarioUnidad[]
  reservas     Reserva[]
}

model UsuarioUnidad {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  unidadId String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  @@unique([userId, unidadId])
  @@index([unidadId])
}

model AreaComun {
  id        String        @id @default(uuid()) @db.Uuid
  nombre    String        @unique @db.VarChar(60)
  capacidad Int
  activa    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  horarios  HorarioArea[]
  reservas  Reserva[]
}

model HorarioArea {
  id         String    @id @default(uuid()) @db.Uuid
  areaId     String    @db.Uuid
  diaSemana  Int
  horaInicio String    @db.VarChar(5)
  horaFin    String    @db.VarChar(5)
  area       AreaComun @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId, diaSemana])
}

model Reserva {
  id          String        @id @default(uuid()) @db.Uuid
  codigo      String        @unique @default(dbgenerated("reserva_codigo()"))
  areaId      String        @db.Uuid
  unidadId    String        @db.Uuid
  userId      String        @db.Uuid
  inicio      DateTime      @db.Timestamptz(3)
  fin         DateTime      @db.Timestamptz(3)
  asistentes  Int
  estado      EstadoReserva @default(CONFIRMADA)
  canceladaAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  area        AreaComun     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  unidad      Unidad        @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([areaId, inicio, fin])
  @@index([unidadId, estado, inicio])
}
